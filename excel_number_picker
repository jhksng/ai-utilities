"""엑셀을 추첨된 행과 나머지 행으로 나누고 각각 1번부터 다시 번호를 매깁니다.

실행 전: python -m pip install openpyxl
실행:    python number_picker.py
"""

import random
import re
import os
import tempfile
import tkinter as tk
from copy import copy
from pathlib import Path
from tkinter import filedialog, messagebox, ttk

try:
    from openpyxl import load_workbook
    from openpyxl.utils import get_column_letter
except ImportError as exc:
    raise SystemExit("openpyxl이 필요합니다. 먼저 'python -m pip install openpyxl'을 실행하세요.") from exc


def number_from_cell(value):
    """정수 및 공백을 제외한 정수 문자열만 번호로 취급합니다."""
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float) and value.is_integer():
        return int(value)
    if isinstance(value, str) and re.fullmatch(r"[+-]?\d+", value.strip()):
        return int(value.strip())
    return None


def keep_selected_rows(ws, selected_rows):
    """첫 행과 선택된 데이터 행만 원본 순서로 남깁니다."""
    keep = [1] + sorted(set(selected_rows))
    positions = {old: new for new, old in enumerate(keep, 1)}
    dimensions = {positions[row]: copy(dim) for row, dim in ws.row_dimensions.items() if row in positions}
    merges = []
    for area in list(ws.merged_cells.ranges):
        rows = list(range(area.min_row, area.max_row + 1))
        retained = [row for row in rows if row in positions]
        if retained and len(retained) != len(rows):
            raise ValueError("여러 행에 걸친 병합 셀에 선택되지 않은 행이 포함되어 있습니다. 해당 병합을 해제한 뒤 다시 실행하세요.")
        if retained:
            merges.append((positions[area.min_row], area.min_col, positions[area.max_row], area.max_col))
        ws.unmerge_cells(str(area))
    # 아래쪽부터 연속된 미선택 행을 삭제해 원본 번호와 전체 열 내용을 보존합니다.
    row = ws.max_row
    while row >= 2:
        if row in positions:
            row -= 1
            continue
        end = row
        while row >= 2 and row not in positions:
            row -= 1
        ws.delete_rows(row + 1, end - row)
    ws.row_dimensions.clear()
    for row, dim in dimensions.items():
        dim.index = row
        dim.hidden = False
        ws.row_dimensions[row] = dim
    for first_row, first_col, last_row, last_col in merges:
        ws.merge_cells(start_row=first_row, start_column=first_col, end_row=last_row, end_column=last_col)
    # 이전 필터 조건이 추첨된 행을 숨기지 않도록 해제합니다.
    if ws.auto_filter.ref:
        ws.auto_filter.ref = f"A1:{get_column_letter(ws.max_column)}{len(keep)}"
        ws.auto_filter.filterColumn = []
        ws.auto_filter.sortState = None
    from openpyxl.utils.cell import range_boundaries
    for table in list(ws.tables.values()):
        left, top, right, bottom = range_boundaries(table.ref)
        table_rows = [positions[r] for r in keep if top <= r <= bottom]
        if table_rows and top in positions:
            table.ref = f"{get_column_letter(left)}{min(table_rows)}:{get_column_letter(right)}{max(table_rows)}"
            if table.autoFilter:
                table.autoFilter.ref = table.ref
                table.autoFilter.filterColumn = []
                table.autoFilter.sortState = None
        else:
            del ws.tables[table.name]
    ws.print_area = f"A1:{get_column_letter(ws.max_column)}{len(keep)}"


class Picker(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("엑셀 번호 랜덤 추첨")
        self.geometry("710x640")
        self.minsize(660, 585)
        self.path = tk.StringVar()
        self.sheet = tk.StringVar()
        self.column = tk.StringVar()
        self.start = tk.StringVar(value="1")
        self.end = tk.StringVar(value="100")
        self.count = tk.StringVar(value="30")
        self.status = tk.StringVar(value="엑셀 파일을 선택하세요.")

        box = ttk.Frame(self, padding=18)
        box.pack(fill="both", expand=True)
        ttk.Label(box, text="엑셀 번호 추첨", font=("맑은 고딕", 17, "bold")).pack(anchor="w", pady=(0, 15))

        file_row = ttk.Frame(box)
        file_row.pack(fill="x", pady=5)
        ttk.Label(file_row, text="엑셀 파일", width=12).pack(side="left")
        ttk.Entry(file_row, textvariable=self.path, state="readonly").pack(side="left", fill="x", expand=True, padx=(0, 8))
        ttk.Button(file_row, text="찾아보기", command=self.select_file).pack(side="left")

        self.sheet_box = self.combo_row(box, "시트", self.sheet, self.select_sheet)
        self.column_box = self.combo_row(box, "번호 열", self.column)

        range_row = ttk.Frame(box)
        range_row.pack(fill="x", pady=7)
        ttk.Label(range_row, text="번호 범위", width=12).pack(side="left")
        ttk.Entry(range_row, textvariable=self.start, width=12).pack(side="left")
        ttk.Label(range_row, text="  ~  ").pack(side="left")
        ttk.Entry(range_row, textvariable=self.end, width=12).pack(side="left")
        ttk.Label(range_row, text="       뽑을 개수").pack(side="left")
        ttk.Entry(range_row, textvariable=self.count, width=10).pack(side="left", padx=7)

        ttk.Label(box, text="첫 행은 머리글로 사용합니다. 선택한 번호 열의 2행부터 번호를 찾습니다.", foreground="#555").pack(anchor="w", pady=(10, 5))
        ttk.Label(box, text="선택한 시트를 '추첨된 행'과 '나머지 행'으로 나눠 두 파일로 저장합니다.", foreground="#555").pack(anchor="w", pady=5)
        ttk.Label(box, text="범위 밖의 데이터도 나머지 파일에 포함됩니다. 다른 시트는 유지됩니다.", foreground="#555").pack(anchor="w")
        ttk.Label(box, text="두 파일 모두 선택한 번호 열을 1번부터 다시 매깁니다. 내용과 행 순서는 유지됩니다.", foreground="#555").pack(anchor="w", pady=(5, 0))
        ttk.Button(box, text="추첨하고 엑셀 2개 저장", command=self.draw).pack(anchor="w", pady=10)
        ttk.Label(box, text="추첨 결과 (원본 번호 · 뽑힌 순서)", font=("맑은 고딕", 11, "bold")).pack(anchor="w", pady=(10, 5))
        self.result = tk.Text(box, height=9, wrap="word", state="disabled", font=("맑은 고딕", 11))
        self.result.pack(fill="both", expand=True)
        ttk.Label(box, textvariable=self.status, wraplength=620).pack(anchor="w", pady=(12, 0))

    def combo_row(self, parent, label, variable, command=None):
        row = ttk.Frame(parent)
        row.pack(fill="x", pady=5)
        ttk.Label(row, text=label, width=12).pack(side="left")
        widget = ttk.Combobox(row, textvariable=variable, state="readonly")
        widget.pack(side="left", fill="x", expand=True)
        if command:
            widget.bind("<<ComboboxSelected>>", command)
        return widget

    def select_file(self):
        filename = filedialog.askopenfilename(filetypes=[("Excel 파일", "*.xlsx *.xlsm")])
        if not filename:
            return
        try:
            workbook = load_workbook(filename, read_only=True, data_only=True)
            names = workbook.sheetnames
            workbook.close()
            self.path.set(filename)
            self.sheet_box["values"] = names
            self.sheet.set(names[0])
            self.select_sheet()
            self.status.set("번호가 있는 시트와 열을 확인한 뒤 추첨하세요.")
        except Exception as exc:
            messagebox.showerror("파일 오류", f"엑셀 파일을 열 수 없습니다.\n{exc}")

    def select_sheet(self, _event=None):
        workbook = None
        try:
            # 일부 XLSX에는 dimension(사용 범위) 정보가 없습니다.
            # 일반 모드로 읽으면 실제 셀에서 행/열 범위를 계산하므로
            # read_only 모드의 max_column=None 오류를 피할 수 있습니다.
            workbook = load_workbook(self.path.get(), data_only=True)
            ws = workbook[self.sheet.get()]
            labels = []
            for col in range(1, ws.max_column + 1):
                header = str(ws.cell(1, col).value or "").strip()
                labels.append(f"{get_column_letter(col)} — {header}" if header else get_column_letter(col))
            self.column_box["values"] = labels
            self.column.set(labels[0] if labels else "")
        except Exception as exc:
            messagebox.showerror("시트 오류", str(exc))
        finally:
            if workbook is not None:
                workbook.close()

    def draw(self):
        wb = None
        remainder_wb = None
        staged = []
        try:
            if not self.path.get() or not self.sheet.get() or not self.column.get():
                raise ValueError("엑셀 파일, 시트, 번호 열을 선택하세요.")
            start, end, count = (int(v.get().strip()) for v in (self.start, self.end, self.count))
            if start > end:
                raise ValueError("번호 범위의 시작값이 끝값보다 큽니다.")
            if not 1 <= count <= end - start + 1:
                raise ValueError("뽑을 개수는 1 이상이며 번호 범위의 크기 이하여야 합니다.")
            source = Path(self.path.get())
            wb = load_workbook(source, keep_vba=source.suffix.lower() == ".xlsm")
            ws = wb[self.sheet.get()]
            letter = self.column.get().split(" ", 1)[0]
            from openpyxl.utils.cell import column_index_from_string
            col = column_index_from_string(letter)
            indexed = {}
            for row in range(2, ws.max_row + 1):
                number = number_from_cell(ws.cell(row, col).value)
                if number is not None and start <= number <= end:
                    indexed.setdefault(number, []).append(row)
            if end - start + 1 > ws.max_row - 1:
                raise ValueError("번호 범위가 엑셀 데이터 행 수보다 큽니다. 범위와 번호 열을 확인하세요.")
            missing = [n for n in range(start, end + 1) if n not in indexed]
            duplicate = [n for n, rows in indexed.items() if len(rows) > 1]
            if missing:
                shown = ", ".join(map(str, missing[:15]))
                raise ValueError(f"엑셀 번호 열에 범위 내 번호 {len(missing)}개가 없습니다: {shown}{' …' if len(missing) > 15 else ''}\n번호 열이나 범위를 확인하세요.")
            if duplicate:
                shown = ", ".join(map(str, duplicate[:15]))
                raise ValueError(f"엑셀 번호 열에 중복 번호가 있습니다: {shown}{' …' if len(duplicate) > 15 else ''}\n번호가 한 번씩만 나타나도록 수정하세요.")

            destination = filedialog.asksaveasfilename(
                defaultextension=source.suffix,
                filetypes=[("Excel 파일", f"*{source.suffix}")],
                title="추첨된 행 파일의 저장 위치 선택 (나머지 파일도 같은 폴더에 저장)",
                initialfile=f"{source.stem}_추첨{count}개{source.suffix}",
            )
            if not destination:
                wb.close()
                self.status.set("저장을 취소했습니다. 추첨은 진행하지 않았습니다.")
                return
            if Path(destination).resolve() == source.resolve():
                raise ValueError("원본 파일을 덮어쓸 수 없습니다. 다른 파일 이름을 선택하세요.")
            destination = Path(destination)
            if destination.suffix.lower() != source.suffix.lower():
                raise ValueError(f"원본과 같은 {source.suffix} 확장자로 저장하세요.")
            remaining_count = ws.max_row - 1 - count
            remaining_path = destination.with_name(f"{destination.stem}_나머지{remaining_count}개{source.suffix}")
            if remaining_path.resolve() == source.resolve():
                raise ValueError("나머지 파일 이름이 원본과 같습니다. 다른 저장 이름을 선택하세요.")
            if remaining_path.exists() and not messagebox.askyesno("파일 덮어쓰기", f"다음 파일이 이미 있습니다. 교체할까요?\n{remaining_path}"):
                self.status.set("저장을 취소했습니다. 추첨은 진행하지 않았습니다.")
                return

            picked = random.SystemRandom().sample(range(start, end + 1), count)
            selected_rows = {indexed[number][0] for number in picked}
            remaining_rows = [row for row in range(2, ws.max_row + 1) if row not in selected_rows]
            remainder_wb = load_workbook(source, keep_vba=source.suffix.lower() == ".xlsm")
            keep_selected_rows(ws, selected_rows)
            keep_selected_rows(remainder_wb[self.sheet.get()], remaining_rows)
            # 머리글은 그대로 두고 각 결과의 번호 열만 1부터 다시 매깁니다.
            for output_ws in (ws, remainder_wb[self.sheet.get()]):
                for row in range(2, output_ws.max_row + 1):
                    cell = output_ws.cell(row, col, row - 1)
                    cell.number_format = "0"
            # 두 결과를 모두 생성한 후 지정된 이름으로 옮깁니다.
            for book, output in ((wb, destination), (remainder_wb, remaining_path)):
                fd, temporary = tempfile.mkstemp(dir=output.parent, suffix=source.suffix)
                os.close(fd)
                staged.append((Path(temporary), output))
                book.save(temporary)
            saved = []
            for temporary, output in staged:
                try:
                    os.replace(temporary, output)
                    saved.append(str(output))
                except OSError as exc:
                    details = "\n".join(saved) if saved else "없음"
                    raise OSError(f"파일 저장에 실패했습니다. 대상 파일이 Excel에서 열려 있다면 닫아주세요.\n이미 저장된 파일: {details}\n{exc}") from exc
            self.result.configure(state="normal")
            self.result.delete("1.0", "end")
            self.result.insert("end", ", ".join(map(str, picked)))
            self.result.configure(state="disabled")
            self.status.set(f"추첨 {count}개 / 나머지 {len(remaining_rows)}행 · 엑셀 2개 저장 완료")
            messagebox.showinfo("완료", f"추첨된 {count}개 행:\n{destination}\n\n나머지 {len(remaining_rows)}개 행:\n{remaining_path}")
        except Exception as exc:
            messagebox.showerror("확인 필요", str(exc))
        finally:
            if wb is not None:
                wb.close()
            if remainder_wb is not None:
                remainder_wb.close()
            for temporary, _output in staged:
                if temporary.exists():
                    temporary.unlink()


if __name__ == "__main__":
    Picker().mainloop()
